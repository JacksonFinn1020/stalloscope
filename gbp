#!/usr/bin/env python3
"""gbp — Grok Bot Progress CLI stub.

  gbp serve
  gbp emit --task-id ... --bot-id ... --title ... --state running [--progress 42] [--detail ...]
  gbp wrap [--task-id ...] [--bot-id ...] [--title ...] -- <cmd...>
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request
from datetime import datetime, timezone, timedelta
from pathlib import Path
from typing import Dict, Iterable, List, Optional, Tuple

ROOT = Path(__file__).resolve().parent
DAEMON = ROOT / "daemon" / "server.py"
DEFAULT_BASE = os.environ.get("GBP_URL", "http://127.0.0.1:7310")
SHANGHAI = timezone(timedelta(hours=8), name="Asia/Shanghai")

PCT_RE = re.compile(r"(\d{1,3}(?:\.\d+)?)\s*%")
DOCKER_PHASE_RE = re.compile(
    r"\b(Downloading|Download complete|Extracting|Pull complete|Waiting|"
    r"Verifying Checksum|Already exists|Pulling fs layer)\b",
    re.IGNORECASE,
)

LAYER_LINE_RE = re.compile(
    r"^([a-f0-9]{6,64}|[A-Za-z0-9._-]{4,80}):\s*(.+)$",
    re.IGNORECASE,
)
DOWNLOAD_BYTES_RE = re.compile(
    r"Downloading\s+\[[^\]]*\]\s*"
    r"([\d.]+)\s*([KMGT]?B)\s*/\s*([\d.]+)\s*([KMGT]?B)",
    re.IGNORECASE,
)
EXTRACT_PCT_RE = re.compile(
    r"Extracting\s+\[[^\]]*\]\s*(\d{1,3}(?:\.\d+)?)\s*%",
    re.IGNORECASE,
)
UNIT_MULT = {
    "B": 1.0,
    "KB": 1024.0,
    "MB": 1024.0 ** 2,
    "GB": 1024.0 ** 3,
    "TB": 1024.0 ** 4,
}


def _to_bytes(value: float, unit: str) -> float:
    return value * UNIT_MULT.get(unit.upper(), 1.0)


def split_progress_fragments(text: str) -> List[str]:
    """Split on both \\n and \\r (docker refreshes in-place with \\r)."""
    if not text:
        return []
    parts = re.split(r"[\r\n]+", text)
    return [p for p in parts if p.strip()]


def iter_stream_fragments(stream) -> Iterable[str]:
    """Read binary or text stream; yield fragments split on \\n or \\r."""
    buf = ""
    while True:
        chunk = stream.read(256)
        if not chunk:
            break
        if isinstance(chunk, bytes):
            chunk = chunk.decode("utf-8", errors="replace")
        buf += chunk
        while True:
            i_n = buf.find("\n")
            i_r = buf.find("\r")
            if i_n < 0 and i_r < 0:
                break
            if i_n < 0:
                idx, sep = i_r, "\r"
            elif i_r < 0:
                idx, sep = i_n, "\n"
            else:
                idx, sep = (i_r, "\r") if i_r < i_n else (i_n, "\n")
            frag = buf[:idx]
            buf = buf[idx + 1 :]
            if sep == "\r" and buf.startswith("\n"):
                buf = buf[1:]
            if frag.strip():
                yield frag
    if buf.strip():
        yield buf


class DockerPullTracker:
    """Track per-layer docker pull progress; overall = mean of known layers."""

    def __init__(self) -> None:
        self.layers: Dict[str, float] = {}
        self.detail: Optional[str] = None
        self.phase: Optional[str] = None
        self._last_emitted_progress: Optional[float] = None
        self._last_emitted_phase: Optional[str] = None
        self._last_emitted_detail: Optional[str] = None

    @property
    def overall(self) -> Optional[float]:
        if not self.layers:
            return None
        avg = sum(self.layers.values()) / max(len(self.layers), 1)
        return max(0.0, min(100.0, round(avg, 1)))

    def feed_fragment(self, fragment: str) -> Tuple[Optional[float], Optional[str], Optional[str]]:
        line = fragment.strip()
        if not line:
            return self.overall, self.detail, self.phase

        m = LAYER_LINE_RE.match(line)
        if not m:
            if DOCKER_PHASE_RE.search(line) or "Status:" in line or "Digest:" in line:
                self.detail = line[:240]
            return self.overall, self.detail, self.phase

        layer_id, rest = m.group(1), m.group(2).strip()
        phase_m = DOCKER_PHASE_RE.search(rest)
        phase = phase_m.group(1).lower() if phase_m else None
        progress: Optional[float] = None

        if re.search(r"\b(Pull complete|Already exists|Download complete)\b", rest, re.I):
            progress = 100.0
            phase = phase or "pull complete"
        elif re.search(r"\bWaiting\b", rest, re.I):
            self.layers.setdefault(layer_id, self.layers.get(layer_id, 0.0))
            phase = "waiting"
            self.detail = line[:240]
            self.phase = phase
            return self.overall, self.detail, self.phase
        else:
            dl = DOWNLOAD_BYTES_RE.search(rest)
            if dl:
                cur = _to_bytes(float(dl.group(1)), dl.group(2))
                total = _to_bytes(float(dl.group(3)), dl.group(4))
                if total > 0:
                    progress = max(0.0, min(100.0, (cur / total) * 100.0))
                phase = "downloading"
            else:
                ex = EXTRACT_PCT_RE.search(rest)
                if ex:
                    progress = max(0.0, min(100.0, float(ex.group(1))))
                    phase = "extracting"
                else:
                    pct = PCT_RE.search(rest)
                    if pct:
                        progress = max(0.0, min(100.0, float(pct.group(1))))
                    if phase is None and "downloading" in rest.lower():
                        phase = "downloading"
                    elif phase is None and "extracting" in rest.lower():
                        phase = "extracting"

        if progress is not None:
            self.layers[layer_id] = progress
        else:
            self.layers.setdefault(layer_id, self.layers.get(layer_id, 0.0))

        self.detail = line[:240]
        if phase:
            self.phase = phase
        return self.overall, self.detail, self.phase

    def feed_text(self, text: str) -> Tuple[Optional[float], Optional[str], Optional[str]]:
        for frag in split_progress_fragments(text):
            self.feed_fragment(frag)
        return self.overall, self.detail, self.phase

    def should_emit(
        self, progress: Optional[float], phase: Optional[str], detail: Optional[str]
    ) -> bool:
        if progress is not None and self._last_emitted_progress is None:
            return True
        if phase and phase != self._last_emitted_phase:
            return True
        if progress is not None and self._last_emitted_progress is not None:
            if abs(progress - self._last_emitted_progress) >= 1.0:
                return True
        if detail and self._last_emitted_detail is None and progress is not None:
            return True
        return False

    def mark_emitted(
        self, progress: Optional[float], phase: Optional[str], detail: Optional[str]
    ) -> None:
        self._last_emitted_progress = progress
        self._last_emitted_phase = phase
        self._last_emitted_detail = detail


def looks_like_docker_pull(cmd: List[str]) -> bool:
    if not cmd:
        return False
    if cmd[0] == "docker" and "pull" in cmd[1:3]:
        return True
    if cmd[0] in ("podman", "nerdctl") and "pull" in cmd[1:3]:
        return True
    joined = " ".join(cmd).lower()
    base = Path(cmd[0]).name.lower()
    if "docker" in base and "pull" in base:
        return True
    if "fake_docker_pull" in joined or "docker_pull" in base:
        return True
    return False


def heuristic_progress(line: str) -> Tuple[Optional[float], Optional[str]]:
    detail = line.strip()
    if not detail:
        return None, None
    m = PCT_RE.search(detail)
    progress: Optional[float] = None
    if m:
        try:
            v = float(m.group(1))
            if 0 <= v <= 100:
                progress = v
        except ValueError:
            pass
    phase = DOCKER_PHASE_RE.search(detail)
    if phase and progress is None:
        name = phase.group(1).lower()
        if name in ("waiting",):
            return None, detail[:240]
        if name in (
            "downloading",
            "extracting",
            "download complete",
            "pull complete",
            "already exists",
        ):
            return progress, detail[:240]
    if progress is not None or phase:
        return progress, detail[:240]
    if "docker" in detail.lower() or ("/" in detail and "MB" in detail):
        return None, detail[:240]
    return None, detail[:240] if len(detail) > 8 else None


def now_iso() -> str:
    return datetime.now(SHANGHAI).isoformat(timespec="seconds")


def post_event(base: str, event: dict) -> dict:
    url = base.rstrip("/") + "/v1/events"
    data = json.dumps(event).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.URLError as e:
        raise SystemExit(f"gbp: cannot reach daemon at {url}: {e}") from e


def cmd_serve(_args: argparse.Namespace) -> int:
    if not DAEMON.is_file():
        print(f"gbp: missing {DAEMON}", file=sys.stderr)
        return 1
    os.execv(sys.executable, [sys.executable, str(DAEMON)])
    return 1


def build_event(
    task_id: str,
    bot_id: str,
    title: str,
    state: str,
    progress: Optional[float],
    detail: Optional[str],
    updated_at: Optional[str] = None,
) -> dict:
    return {
        "task_id": task_id,
        "bot_id": bot_id,
        "title": title,
        "state": state,
        "progress": progress,
        "detail": detail,
        "updated_at": updated_at or now_iso(),
    }


def cmd_emit(args: argparse.Namespace) -> int:
    progress = args.progress
    if progress is not None:
        progress = float(progress)
    event = build_event(
        task_id=args.task_id,
        bot_id=args.bot_id,
        title=args.title,
        state=args.state,
        progress=progress,
        detail=args.detail,
    )
    resp = post_event(args.url, event)
    print(json.dumps(resp, ensure_ascii=False))
    return 0 if resp.get("ok") else 1


def cmd_wrap(args: argparse.Namespace) -> int:
    cmd = args.cmd
    if not cmd:
        print("gbp wrap: missing command after --", file=sys.stderr)
        return 2
    task_id = args.task_id or ("wrap-" + "-".join(cmd[:2]).replace("/", "_")[:48])
    bot_id = args.bot_id or "gbp-wrap"
    title = args.title or " ".join(cmd)[:120]
    base = args.url
    use_docker = looks_like_docker_pull(cmd)

    def emit(state: str, progress: Optional[float], detail: Optional[str]) -> None:
        event = build_event(task_id, bot_id, title, state, progress, detail)
        try:
            post_event(base, event)
        except SystemExit as e:
            print(str(e), file=sys.stderr)

    emit("running", 0.0 if use_docker else None, f"starting: {' '.join(cmd)}")

    proc = subprocess.Popen(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    assert proc.stdout is not None

    last_progress: Optional[float] = 0.0 if use_docker else None
    tracker = DockerPullTracker() if use_docker else None
    last_generic_prog: Optional[float] = None
    last_generic_detail: Optional[str] = None

    try:
        if use_docker:
            assert tracker is not None
            for frag in iter_stream_fragments(proc.stdout):
                sys.stdout.write(frag + "\n")
                sys.stdout.flush()
                prog, detail, phase = tracker.feed_fragment(frag)
                if tracker.should_emit(prog, phase, detail):
                    emit("running", prog, detail)
                    tracker.mark_emitted(prog, phase, detail)
                    if prog is not None:
                        last_progress = prog
                elif prog is not None:
                    last_progress = prog
        else:
            for frag in iter_stream_fragments(proc.stdout):
                sys.stdout.write(frag + "\n")
                sys.stdout.flush()
                prog, detail = heuristic_progress(frag)
                if detail is None and prog is None:
                    continue
                changed = False
                if prog is not None and (
                    last_generic_prog is None or abs(prog - last_generic_prog) >= 1.0
                ):
                    changed = True
                if detail and detail != last_generic_detail and prog is not None:
                    changed = True
                if prog is not None:
                    last_progress = prog
                    last_generic_prog = prog
                if changed:
                    last_generic_detail = detail
                    emit(
                        "running",
                        prog if prog is not None else last_progress,
                        detail,
                    )
    except KeyboardInterrupt:
        proc.terminate()
        emit("failed", last_progress, "interrupted")
        return 130

    code = proc.wait()
    if code == 0:
        emit("done", 100.0, "exit 0")
    else:
        emit("failed", last_progress, f"exit {code}")
    return code


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="gbp", description="Grok Bot Progress CLI")
    sub = p.add_subparsers(dest="command", required=True)

    sp = sub.add_parser("serve", help="start local daemon on 127.0.0.1:7310")
    sp.set_defaults(func=cmd_serve)

    ep = sub.add_parser("emit", help="POST one progress event")
    ep.add_argument("--task-id", required=True)
    ep.add_argument("--bot-id", required=True)
    ep.add_argument("--title", required=True)
    ep.add_argument(
        "--state",
        required=True,
        choices=["running", "blocked", "done", "failed", "idle"],
    )
    ep.add_argument("--progress", type=float, default=None, help="0-100; omit for null")
    ep.add_argument("--detail", default=None)
    ep.add_argument("--url", default=DEFAULT_BASE)
    ep.set_defaults(func=cmd_emit)

    wp = sub.add_parser("wrap", help="run a command and emit progress heuristics")
    wp.add_argument("--task-id", default=None)
    wp.add_argument("--bot-id", default=None)
    wp.add_argument("--title", default=None)
    wp.add_argument("--url", default=DEFAULT_BASE)
    wp.add_argument("cmd", nargs=argparse.REMAINDER, help="command after --")
    wp.set_defaults(func=cmd_wrap)

    return p


def main(argv: Optional[List[str]] = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.command == "wrap" and args.cmd and args.cmd[0] == "--":
        args.cmd = args.cmd[1:]
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
